# /home/admin2/javert/.env — 真生产 admin2:admin2, mode 0600
# 拷贝到 /home/admin2/javert/.env, 填实际值, 切勿把真实凭据入 git

# ============================================================
# 142 SQL Server 双写 (与 Zadig 共用 zadig 库, javert_* 前缀隔离)
# ============================================================
JAVERT_SQL_ENABLED=true
JAVERT_SQL_HOST=192.168.31.142
JAVERT_SQL_PORT=1433
JAVERT_SQL_DATABASE=zadig
JAVERT_SQL_USER=machendong
JAVERT_SQL_PASSWORD=<DBA-issued>
JAVERT_SQL_DRIVER=ODBC Driver 18 for SQL Server

# 62 当前只读源；其他环境由 DBA 确认。默认先关闭 SQL 原文回退。
JAVERT_HUB_RAW_ENABLED=false
JAVERT_HUB_DATABASE=sh_yb_platform

# ============================================================
# 工作台 session (itsdangerous 签名)
# 一次性生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 改了会让所有 in-flight session 失效 — 谨慎
# ============================================================
JAVERT_SESSION_SECRET=<填入 32+ 字符随机串>
JAVERT_SESSION_MAX_AGE=2592000
JAVERT_SESSION_COOKIE_NAME=javert_session
JAVERT_SESSION_HTTPS_ONLY=false
JAVERT_SESSION_SAME_SITE=lax

# ============================================================
# Web 服务
# ============================================================
JAVERT_WEB_HOST=0.0.0.0
JAVERT_WEB_PORT=8090
JAVERT_WEB_WITH_MSSQL=true
JAVERT_WEB_RELOAD=false

# ============================================================
# LLM (audit-engine 跑 audit 时)
# ============================================================
JAVERT_LLM_ENDPOINT=http://192.168.31.62:30000/v1
JAVERT_LLM_MODEL=Qwen/Qwen3.6-35B-A3B-FP8

# 肿瘤药医保资格 v2：新环境先 off；完成 shadow 验收并获生产授权后再切 on
JAVERT_ONCOLOGY_ELIGIBILITY_V2=off
