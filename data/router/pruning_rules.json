      "patient_field": "visit_type"
    },
    "RULE3": {
      "dim": "patient_gender",
      "patient_field": "gender"
    },
    "RULE4": {
      "dim": "patient_age",
      "patient_field": "age"
    },
    "RULE5": {
      "dim": "hospital_level",
      "patient_field": "hospital_level"
    },
